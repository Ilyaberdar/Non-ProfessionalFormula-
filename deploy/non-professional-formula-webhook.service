[Unit]
Description=Non Professional Formula GitHub Webhook Listener
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=quant-intelligence
WorkingDirectory=/opt/non-professional-formula
EnvironmentFile=/opt/non-professional-formula/deploy/webhook.env
ExecStart=/usr/bin/python3 /opt/non-professional-formula/deploy/github_webhook_listener.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
