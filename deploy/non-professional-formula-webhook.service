[Unit]
Description=Non Professional Formula GitHub Webhook Listener
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=quant-intelligence
WorkingDirectory=/home/quant-intelligence/Desktop/github/Non-ProfessionalFormula-
EnvironmentFile=/home/quant-intelligence/Desktop/github/Non-ProfessionalFormula-/deploy/webhook.env
ExecStart=/usr/bin/python3 /home/quant-intelligence/Desktop/github/Non-ProfessionalFormula-/deploy/github_webhook_listener.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
